        "train = train.drop_duplicates(subset=[\"date\"], keep=\"first\").copy()\n",
        "test = test.drop_duplicates(subset=[\"date\"], keep=\"first\").copy()\n",
        "\n",
        "print(\"중복 처리 후 train:\", train.shape)\n",
